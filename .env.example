# Amadeus Self-Service API (tier gratuito): https://developers.amadeus.com
# Credenciais ficam SO no servidor (server/index.js) — nunca vao para o browser.
# Sem chaves, o app usa dados MOCK automaticamente (nada quebra).
# Copie para .env e preencha:
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# "test" (sandbox gratuito) ou "production"
AMADEUS_ENV=test

# seats.aero Partner API (disponibilidade de award/milhas): https://seats.aero
# Chave fica so no servidor. Sem chave, a estrategia de milhas usa mock.
SEATS_AERO_API_KEY=

# Duffel (ofertas reais: cia + NDC + agencias): https://duffel.com
# Token de TEST retorna ofertas sinteticas para qualquer rota (bom p/ demo).
# Sem token, a estrategia de consolidador usa mock.
DUFFEL_ACCESS_TOKEN=

# Porta do proxy backend (opcional; padrao 3001)
PORT=3001

# --- Cache e rate-limit do proxy (todos opcionais; valores = padrao) ---
# Cache de respostas em memoria
CACHE_MAX=500            # entradas maximas no cache (LRU)
OFFERS_TTL_MS=300000     # TTL de flight-offers (5 min)
DATES_TTL_MS=1800000     # TTL de flight-dates (30 min)
# Rate-limit por IP (janela fixa)
RATE_IP_MAX=60           # requisicoes por janela, por IP
RATE_WINDOW_MS=60000     # tamanho da janela (1 min)
# Tetos de chamadas por upstream (protege as cotas dos tiers gratuitos)
AMADEUS_MAX_PER_MIN=40
SEATS_MAX_PER_MIN=10
DUFFEL_MAX_PER_MIN=20
AWARD_TTL_MS=1800000     # TTL de award seats.aero (30 min)
DUFFEL_TTL_MS=300000     # TTL de ofertas Duffel (5 min)
